{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "supastarter core: TanStack Start",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true
  }
}
