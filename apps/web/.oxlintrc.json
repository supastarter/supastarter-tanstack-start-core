{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@repo/oxc-config/oxlint/react.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "./src/env.ts", "@tanstack/react-start"] }
    ]
  },
  "overrides": [
    {
      "files": ["*.config.ts", "e2e/**"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    ".output/**",
    ".nitro/**",
    "dist/**",
    ".wrangler/**",
    ".vercel/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
