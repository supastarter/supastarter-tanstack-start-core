{
  "extends": "@repo/typescript-config/tanstack-start.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    ".output",
    ".nitro",
    "dist",
    ".wrangler",
    ".vercel",
    "test-results",
    "playwright-report",
    "oxlint.config.ts",
    "src/routeTree.gen.ts"
  ]
}
