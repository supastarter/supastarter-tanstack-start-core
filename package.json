{
  "name": "supastarter-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "oxfmt --check && turbo run lint type-check test",
    "verify": "pnpm run check && turbo run build test:e2e"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "turbo": "2.11.11"
  }
}
